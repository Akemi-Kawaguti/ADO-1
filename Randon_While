/* Treinando uso do While
O usuário deve tentar acertar um número aleatório
Para ajudá-lo o programa deve informar sobre as tentativas */

import java.util.Random;
import java.util.Scanner;

public class Randon_While {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        int tentativa = 0;

        Random r = new Random();
        int numero = r.nextInt(100);

        System.out.println("Digite numero de 0 a 100");

    while (tentativa != numero){
    tentativa = sc.nextInt();

        if (tentativa != numero){
        System.out.println(tentativa > numero ? "O número é mais baixo" : "Tente um número mais alto");
    
        } else {
        System.out.println("Parabens o número era " + numero);
    }

    }

    sc.close();

    }
}
