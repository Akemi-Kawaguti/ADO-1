//6) Faça um programa que receba o salário inicial de um funcionário,
// calcule e mostre o novo salário, acrescido de bonus e de auxilio escola.

import java.util.Scanner;

public class Exercicio_6 {
    public static void main(String[] args) {
        Scanner sc=new Scanner (System.in);

        double salario,bonus,auxilio,total;
        System.out.println("Insira sálario base");
        salario = sc.nextDouble();

        if (salario < 500){
            bonus = salario * 0.05;
        }else if (salario >= 500 && salario < 1200){
            bonus = salario * 0.12;
        }else {
            bonus= 0;
        }
        if (salario < 600){
            auxilio = 150;
        }else{
            auxilio= 100;
        }
        total= salario + bonus + auxilio;
        System.out.println("Total a receber R$ %.2f" +total);
    }
}
